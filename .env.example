# ═══════════════════════════════════════════════════════════════
# WhatsAgent — Environment Variables Template
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ═══════════════════════════════════════════════════════════════

# ─── INFRA ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://whatsagent:whatsagent_secret@localhost:5432/whatsagent"
REDIS_URL="redis://:redis_secret@localhost:6379"
RABBITMQ_URL="amqp://whatsagent:rabbitmq_secret@localhost:5672"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minio_access_key"
MINIO_SECRET_KEY="minio_secret_key"
MINIO_BUCKET="whatsagent-media"

# ─── AUTH (JWT + Google OAuth) ─────────────────────────────────
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars"
JWT_REFRESH_EXPIRES_IN="7d"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_ID: usado pela api para validar o campo aud/azp do token do Google no login social.
# Não é segredo (mesmo valor de NEXT_PUBLIC_GOOGLE_CLIENT_ID) — só precisa ser setado se os dois divergirem.
GOOGLE_CLIENT_ID=""

# ─── AI PROVIDERS ──────────────────────────────────────────────
# OpenAI (required for Whisper and Embeddings)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_COMPLEX="gpt-4o"
OPENAI_MODEL_SIMPLE="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_WHISPER_MODEL="whisper-1"

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=""

# Google Gemini (optional)
GOOGLE_API_KEY=""

# Ollama local models (optional)
OLLAMA_URL="http://localhost:11434"
OLLAMA_ENABLED="false"

# ─── META CLOUD API ────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="whatsagent_verify_2025"
META_WEBHOOK_SECRET=""
META_TEST_PHONE_NUMBER_ID=""

# ─── MERCADO PAGO ──────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET=""

# ─── STRIPE ────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""
STRIPE_METER_ID_CONVERSATIONS=""

# ─── STORAGE AWS S3 ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="sa-east-1"
AWS_S3_BUCKET="whatsagent-media-prod"

# ─── MONITORING ────────────────────────────────────────────────
# Sentry (erros + traces). Sem DSN, a inicialização é no-op (dev não é afetado).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Só necessários em CI para upload de source maps (apps/web); opcionais.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
# Endpoint que recebe os Web Vitals via sendBeacon (shared/monitoring/web-vitals.tsx).
NEXT_PUBLIC_VITALS_URL=""

# ─── SERVICES ──────────────────────────────────────────────────
PORT_WEB=3000
FRONTEND_URL="http://localhost:3000"
PORT_API=3002
NEXT_PUBLIC_API_URL="http://localhost:3002"
PORT_CHANNEL=3001
PORT_AI_ORCHESTRATOR=8000

# ─── INTERNAL SERVICE AUTH ─────────────────────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=""

# ─── PLATFORM EMAIL (SMTP) ─────────────────────────────────────
# Chave para criptografar a senha SMTP salva no banco (AES-256-GCM).
# Gerar com: openssl rand -base64 32
# Config de SMTP (host/porta/usuário/senha) vive no banco, gerenciada pelo
# super-admin em Plataforma > Email — não em env vars.
SETTINGS_ENCRYPTION_KEY=""

# ─── NODE ENV ──────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
