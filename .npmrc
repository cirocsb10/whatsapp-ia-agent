# Sentry's Node instrumentation (import-in-the-middle / require-in-the-middle) needs to be
# resolvable from apps/web's node_modules at runtime; pnpm's default strict isolation nests
# them under @opentelemetry/instrumentation and Next.js can't resolve them from there.
# https://github.com/getsentry/sentry-javascript/issues/15456
public-hoist-pattern[]=*import-in-the-middle*
public-hoist-pattern[]=*require-in-the-middle*
